#!/bin/bash
# Problema 2 - comand1
# Primeste 2 parametri: S (subdirector) si FILE (fisier fara extensie).
# Creeaza S, intra in S, apeleaza OPTIUNE si, in functie de valoare:
#   1 - creeaza prin copiere de la tastatura FILE.TXT
#   2 - sorteaza FILE.TXT in FILE.SRT
#   3 - afiseaza FILE.SRT
# Daca valoarea e diferita de 0, apeleaza din nou OPTIUNE.
# La final afiseaza directorul curent si revine in directorul parinte.

if [ "$#" -ne 2 ]; then
    echo "Utilizare: $0 S FILE" >&2
    exit 1
fi

S=$1
FILE=$2
script_dir=$(cd "$(dirname "$0")" && pwd)
optiune_prog="$script_dir/OPTIUNE"

if [ ! -x "$optiune_prog" ]; then
    if command -v gcc >/dev/null 2>&1; then
        gcc "$script_dir/OPTIUNE.c" -o "$optiune_prog" || exit 1
    else
        echo "Nu exista OPTIUNE executabil si gcc nu este disponibil." >&2
        exit 1
    fi
fi

mkdir -p -- "$S" || exit 1
parinte=$(pwd)
cd -- "$S" || exit 1

while true; do
    "$optiune_prog"
    opt=$?

    if [ "$opt" -eq 0 ]; then
        break
    elif [ "$opt" -eq 1 ]; then
        echo "Introduceti text. Terminati cu Ctrl+D:"
        cat > "$FILE.TXT"
    elif [ "$opt" -eq 2 ]; then
        if [ -f "$FILE.TXT" ]; then
            sort "$FILE.TXT" > "$FILE.SRT"
        else
            echo "Fisierul $FILE.TXT nu exista; operatie ignorata."
        fi
    elif [ "$opt" -eq 3 ]; then
        if [ -f "$FILE.SRT" ]; then
            cat "$FILE.SRT"
        else
            echo "Fisierul $FILE.SRT nu exista; operatie ignorata."
        fi
    else
        echo "OPTIUNE a returnat o valoare neasteptata: $opt"
        break
    fi
done

pwd
cd "$parinte" || exit 1
